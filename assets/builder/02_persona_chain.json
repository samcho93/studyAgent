    {"id": "n5", "type": "chat", "label": "감성 분류 (JSON)", "x": 1020, "y": 200, "config": {"system": "당신은 감성 분석기입니다.", "prompt": "다음 리뷰의 감성을 분류해줘. JSON {\"sentiment\": \"positive|negative|neutral\", \"reason\": \"...\"} 로만 답해.\n\n{input}", "json_mode": true}},
    {"id": "n6", "type": "output", "label": "요약", "x": 1360, "y": 40, "config": {"title": "요약"}},
    {"id": "n7", "type": "output", "label": "감성", "x": 1360, "y": 240, "config": {"title": "감성 분류 (JSON)"}}
