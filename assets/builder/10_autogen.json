    {"id": "n4", "type": "ag_agent", "label": "리뷰어", "x": 380, "y": 220, "config": {"name": "리뷰어", "system_message": "당신은 코드 리뷰어다. 코드를 검토해 개선점을 말하고, 문제가 없으면 TERMINATE 라고 답한다."}},
    {"id": "n5", "type": "ag_chat", "label": "개발자 ↔ 리뷰어", "x": 740, "y": 100, "config": {"max_turns": 3}},
